# =============================================
# Voice Translator Discord - Variables de entorno
# =============================================
# Copia este archivo como .env y rellena los valores
# NUNCA subas el .env a GitHub

# --- ElevenLabs ---
# Obtener en: elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=tu_api_key_aqui

# Obtener en: elevenlabs.io → Voices → tu voz clonada → Voice ID
ELEVENLABS_VOICE_ID=tu_voice_id_aqui

# --- Supabase (Fase SaaS — dejar vacío por ahora) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
